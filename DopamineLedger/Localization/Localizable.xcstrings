    "settings.chill.on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start a spender that's already in debt. Debt accrues at 2× rate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez démarrer un dépenseur déjà endetté. Les dettes s'accumulent au taux 2×."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst einen Ausgeber starten, der bereits Schulden hat. Schulden häufen sich mit 2× Rate an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes iniciar un gastador que ya tiene deudas. Las deudas se acumulan a una tasa 2×."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以开始已有债务的消耗活动。债务以 2 倍速率累积。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに負債のある消費活動を開始できます。負債は2倍の速度で積み上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 부채가 있는 소비 활동을 시작할 수 있습니다. 부채는 2배 속도로 쌓입니다."
          }
        }
      }
    },
    "settings.chill.off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting a spender with debt is blocked — repay first."
