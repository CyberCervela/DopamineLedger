    "activity.guidance.charger.enjoyment.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Würden Sie das sowieso tun? Bei Dingen, die Sie lieben, brauchen Sie weniger Anreize." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You'd do this anyway? You need less incentive for things you love." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Lo harías de todas formas? Necesitas menos incentivos para lo que amas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vous le feriez de toute façon ? Moins d'incitation pour ce que vous aimez." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "どのみちやること？好きなことへの動機付けは必要ありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "어차피 할 일인가요? 좋아하는 일에는 동기부여가 덜 필요합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你本来就会做？你对热爱的事情需要更少的激励。" } }
      }
    },
    "activity.guidance.charger.impact" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "HOHER EINFLUSS" } },
