    "home.empty.all": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet.\nTap + to add your first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien encore.\nAppuyez sur + pour commencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts.\nTippe +, um zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aún.\nPulsa + para añadir el primero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有内容。\n点击 + 开始添加。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もありません。\n+ をタップして追加しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없습니다.\n+ 를 눌러 추가하세요."
          }
        }
      }
    },
    "home.empty.chargers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chargers yet.\nChargers earn credits over time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de chargeurs.\nLes chargeurs gagnent des crédits avec le temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Lader.\nLader verdienen im Laufe der Zeit Credits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cargadores aún.\nLos cargadores ganan créditos con el tiempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有充值活动。\n充值活动会随时间积累积分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャージ活動がまだありません。\nチャージ活動は時間とともにクレジットを獲得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 활동이 없습니다.\n충전 활동은 시간이 지남에 따라 크레딧을 획득합니다."
          }
        }
      }
    },
    "home.empty.spenders": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No spenders yet.\nSpenders spend credits over time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de dépenseurs.\nLes dépenseurs dépensent des crédits avec le temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Ausgeber.\nAusgeber verbrauchen im Laufe der Zeit Credits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin gastadores aún.\nLos gastadores gastan créditos con el tiempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有消耗活动。\n消耗活动会随时间消耗积分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消費活動がまだありません。\n消費活動は時間とともにクレジットを消費します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소비 활동이 없습니다.\n소비 활동은 시간이 지남에 따라 크레딧을 소모합니다."
          }
        }
      }
    },
