{
  "sourceLanguage" : "en",
  "strings" : {
    "›" : {
      "comment" : "A chevron icon.",
      "isCommentAutoGenerated" : true
    },
    "%@ · %@" : {
      "comment" : "A row of text that shows the duration of an activity and the number of credits earned for it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@%@" : {
      "comment" : "A positive or negative value prefixed by a plus sign. The argument is the string “+” or the string “−”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
    "•" : {
      "comment" : "A bullet point.",
      "isCommentAutoGenerated" : true
    },
    "+%@" : {
      "comment" : "A badge displaying the number of credits earned for completing a quest. The argument is the number of credits.",
      "isCommentAutoGenerated" : true
    },
