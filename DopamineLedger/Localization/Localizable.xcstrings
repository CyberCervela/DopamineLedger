        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "高影响力" } }
      }
    },
    "activity.guidance.charger.impact.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ändert das Ihre Richtung? Effektive Aktivitäten bringen mehr Punkte." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes your trajectory? High-leverage activities earn more." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Cambia tu rumbo? Las actividades de alto impacto ganan más." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Change votre trajectoire ? Les activités à fort levier rapportent plus." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "あなたの人生を変える活動ですか？影響力の高い活動はより多くのクレジットを獲得します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "삶의 방향을 바꾸나요? 영향력 높은 활동은 더 많은 크레딧을 얻습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "能改变你的人生轨迹？高影响力活动获得更多积分。" } }
      }
    },
