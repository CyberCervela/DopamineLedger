      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle Aktivitäten, Sitzungen, Schulden und Quests gelöscht und das Guthaben auf 0 zurückgesetzt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes every activity, session, debt, and quest, and resets your balance to 0. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todas las actividades, sesiones, deudas y misiones, y restablece el saldo a 0. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
