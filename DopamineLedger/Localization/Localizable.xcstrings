    "activity.guidance.spender.toxicity.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wie viel Widerstand wollen Sie aufbauen? Höhere Toxizität kostet mehr Punkte." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "How much friction to build in? Higher toxicity costs more credits." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Cuánta fricción quieres crear? Mayor toxicidad cuesta más créditos." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Combien de friction souhaitez-vous ? Une toxicité élevée coûte plus de crédits." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "どれくらい抑制力を持たせますか？毒性が高いほどクレジットを多く消費します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "얼마나 마찰을 만들까요? 독성이 높을수록 더 많은 크레딧을 소모합니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置多少阻力？毒性越高，消耗积分越多。" } }
      }
    },
