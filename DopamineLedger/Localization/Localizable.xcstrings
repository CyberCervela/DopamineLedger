      }
    },
    "alert.wipe.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes every activity, session, debt, and quest, and resets your balance to 0. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime toutes les activités, sessions, dettes et quêtes, et remet le solde à 0. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden alle Aktivitäten, Sitzungen, Schulden und Quests gelöscht und das Guthaben auf 0 zurückgesetzt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todas las actividades, sesiones, deudas y misiones, y restablece el saldo a 0. No se puede deshacer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有活动、会话、债务和任务，并将余额重置为 0。此操作无法撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての活動、セッション、負債、クエストが削除され、残高が0にリセットされます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 활동, 세션, 부채, 퀘스트가 삭제되고 잔액이 0으로 초기화됩니다. 이 작업은 취소할 수 없습니다."
          }
        }
      }
    },
