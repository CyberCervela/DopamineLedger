          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての活動、セッション、負債、クエストが削除され、残高が0にリセットされます。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 활동, 세션, 부채, 퀘스트가 삭제되고 잔액이 0으로 초기화됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
