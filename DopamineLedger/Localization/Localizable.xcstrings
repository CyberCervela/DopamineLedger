{
  "sourceLanguage" : "en",
  "strings" : {
    "›" : {
      "comment" : "A chevron icon.",
      "isCommentAutoGenerated" : true
    },
    "%@ · %@" : {
      "comment" : "A row of text that shows the duration of an activity and the number of credits earned for it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@%@" : {
      "comment" : "A positive or negative value prefixed by a plus sign. The argument is the string “+” or the string “−”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
    "•" : {
      "comment" : "A bullet point.",
      "isCommentAutoGenerated" : true
    },
    "+%@" : {
      "comment" : "A badge displaying the number of credits earned for completing a quest. The argument is the number of credits.",
      "isCommentAutoGenerated" : true
    },
    "activity.archive.confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Entfernen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Eliminar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "削除する" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "삭제" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } }
      }
    },
    "activity.archive.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Aktivität verschwindet aus deiner Liste. Alle Sitzungen und Credits bleiben in der Chronik und in den Statistiken erhalten." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This activity will be removed from your list. All sessions and credits remain in your History and Stats." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La actividad desaparecerá de tu lista. Todas las sesiones y créditos permanecen en el historial y estadísticas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'activité disparaîtra de votre liste. Toutes les sessions et crédits restent dans votre historique et vos statistiques." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この活動はリストから削除されます。すべてのセッションとクレジットは履歴と統計に残ります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 활동이 목록에서 삭제됩니다. 모든 세션과 크레딧은 기록 및 통계에 남습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该活动将从您的列表中删除。所有会话和积分将保留在历史记录和统计数据中。" } }
      }
    },
    "activity.archive.title" : {
      "extractionState" : "manual",
