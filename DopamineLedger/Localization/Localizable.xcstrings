    "settings.wipe.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets every activity, session, debt, quest, and balance."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialise toutes les activités, sessions, dettes, quêtes et le solde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt alle Aktivitäten, Sitzungen, Schulden, Quests und das Guthaben zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece todas las actividades, sesiones, deudas, misiones y el saldo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置所有活动、会话、债务、任务和余额。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての活動、セッション、負債、クエスト、残高をリセットします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 활동, 세션, 부채, 퀘스트, 잔액을 초기화합니다."
          }
        }
      }
    },
    "alert.wipe.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wipe all data?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer toutes les données ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
