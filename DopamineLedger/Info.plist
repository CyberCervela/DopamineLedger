<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist — Dopamine Ledger round 2.

  Pre-populated with the keys round 1 had to discover the hard way:

    UIAppFonts                       — registers Monogram + AbaddonBold so
                                       Font(name:size:) actually finds them.
                                       (INFOPLIST_KEY_UIAppFonts as a build
                                       setting silently doesn't flow into
                                       the generated plist. You need a real
                                       Info.plist file, referenced via
                                       INFOPLIST_FILE in project.yml.)
    ITSAppUsesNonExemptEncryption    — false skips the App Store export-
                                       compliance form on every submission.
    UIUserInterfaceStyle             — Dark locks the app. The design
                                       assumes a dark navy palette.
    UISupportedInterfaceOrientations — portrait only. Round 1 was iPhone-
                                       portrait by design. Revisit if iPad
                                       or landscape is ever requested.

  When you add a new custom font, add the filename to the UIAppFonts array
  AND drop the .ttf into DopamineLedger/Fonts/ so it ships in the bundle.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Dopamine Ledger</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Custom fonts. Drop these .ttf files into DopamineLedger/Fonts/. -->
    <key>UIAppFonts</key>
    <array>
        <string>Monogram.ttf</string>
        <string>AbaddonBold.ttf</string>
    </array>

    <!-- App Store export-compliance shortcut. App uses no custom crypto. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Lock to dark mode — the pixel-art design assumes a dark palette. -->
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>

    <!-- Portrait only, iPhone only. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>AccentColor</string>
    </dict>

    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
</dict>
</plist>
